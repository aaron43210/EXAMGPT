# Copy to .env for local development. In production set these as Hugging Face Space *secrets*.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Supabase → Project Settings → Database → Connection string (Session pooler, port 5432)
DATABASE_URL=sqlite:///./examgpt.db
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated extra allowed origins (e.g. Netlify deploy previews)
CORS_EXTRA_ORIGINS=
ENABLE_DOCS=true
EVAL_ENABLED=false
